# Development Dockerfile with hot reload support
FROM python:3.12-slim

LABEL maintainer="SmartLamp Team"
LABEL description="Smart Lamp API - Development Environment"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r smartlamp && useradd -r -g smartlamp smartlamp

# Set working directory
WORKDIR /app

# Copy dependency files
COPY pyproject.toml requirements.txt ./

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install development dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-asyncio \
    pytest-cov \
    httpx \
    black \
    ruff \
    mypy \
    watchdog

# Copy application code
COPY app ./app

# Create directories
RUN mkdir -p /app/logs /app/data && \
    chown -R smartlamp:smartlamp /app

# Switch to non-root user
USER smartlamp

# Expose ports
EXPOSE 8000 41328 41330

# Run with hot reload in development
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
