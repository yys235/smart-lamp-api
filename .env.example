# Smart Lamp API Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# API Security
API_KEY=your-api-key-here

# UDP Configuration
UDP_PORT=41328
UDP_BUFFER_SIZE=2048

# TCP Configuration
TCP_PORT=41330
TCP_TIMEOUT=5
TCP_CONNECT_TIMEOUT=5

# Gateway
GATEWAY_DISCOVERY_TIMEOUT=30

# Retry
MAX_RETRIES=3
RETRY_DELAY=1.0

# Logging
LOG_LEVEL=INFO
